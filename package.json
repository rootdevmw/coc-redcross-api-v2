    "test:content-editor": "node --test test/content-editor.test.cjs",
    "test:programs": "ts-node src/scripts/programs-test.ts",
    "test:publications": "ts-node src/scripts/publications-test.ts",
    "test:streams": "ts-node src/scripts/streams-test.ts",
    "test:auth": "ts-node src/scripts/auth-test.ts",
    "test:roles": "ts-node src/scripts/roles-test.ts",
    "test:publication-editor": "node --test test/publication-editor.test.cjs",
    "test:stream-editor": "node --test test/stream-editor.test.cjs",
    "test:account-flows": "node --test test/account-flows.test.cjs",
